# dependencies
node_modules/

# builds
dist/
build/
coverage/
*.tsbuildinfo

# generated code (re-created on install / `pnpm codegen`)
apps/api/src/generated/
apps/api/src/graphql/__generated__/
apps/web/src/gql/

# env
.env
.env.*
!.env.example

# logs & OS
*.log
.DS_Store
Thumbs.db

# editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.neon

# graphify knowledge graph — built locally (graphify update .)
graphify-out/

# Browser QA output (pnpm qa:smoke)
qa-output/

# Eval reports (regenerated on every run)
apps/api/evals/*/report*.md

# Claude Code personal settings (local permissions)
.claude/settings.local.json

# Impeccable: binary downloaded per machine on first run
**/skills/impeccable/scripts/bin/
