{
  "name": "tripwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collaborative group trip planner — itinerary, voting and shared expenses with live updates.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta --kill-others-on-fail \"pnpm --filter @tripwise/api dev\" \"pnpm --filter @tripwise/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "codegen": "pnpm -r codegen",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @tripwise/api db:migrate",
    "db:seed": "pnpm --filter @tripwise/api db:seed",
    "db:studio": "pnpm --filter @tripwise/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neon/config": "^1.10.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
