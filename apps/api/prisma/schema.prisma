// Tripwise data model — see docs/decisions.md for rationale.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum TripRole {
  OWNER
  EDITOR
  VIEWER
}

enum ActivityStatus {
  PROPOSED
  SCHEDULED
  DECLINED
}

enum SplitMethod {
  EQUAL
  PERCENT
  EXACT
}

enum BookingType {
  FLIGHT
  STAY
  EVENT
  ATTRACTION
  TOUR
  TRANSPORT
  DINING
  OTHER
}

enum BookingStatus {
  CONFIRMED
  NEEDS_DETAILS
  CANCELLED
}

enum BookingSource {
  MANUAL
  EMAIL
  PDF
  IMAGE
  TEXT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  memberships         TripMember[]
  activities          Activity[]           @relation("ActivityCreatedBy")
  votes               Vote[]
  expensesPaid        Expense[]            @relation("ExpensePaidBy")
  expenseSplits       ExpenseSplit[]
  bookings            Booking[]
  attachments         Attachment[]
  reminderPreferences ReminderPreference[]
  apiTokens           ApiToken[]
  assistantUsage      AssistantUsage[]
}

model Trip {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  destination   String
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  currency      String   @default("EUR") @db.Char(3)
  voteThreshold Int      @default(3)
  /// IANA zone used for activity times and manual bookings, e.g. "Europe/Lisbon".
  timeZone      String   @default("UTC")
  /// Secret for the read-only calendar feed; null until first requested.
  calendarToken String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       TripMember[]
  days          Day[]
  activities    Activity[]
  expenses      Expense[]
  bookings      Booking[]
  attachments   Attachment[]
  reminderPrefs ReminderPreference[]
  chunks        TripChunk[]
}

model TripMember {
  tripId   String   @db.Uuid
  userId   String   @db.Uuid
  role     TripRole @default(EDITOR)
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  @@index([userId])
}

model Day {
  id       String   @id @default(uuid()) @db.Uuid
  tripId   String   @db.Uuid
  date     DateTime @db.Date
  position Int

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([tripId, position])
}

model Activity {
  id            String         @id @default(uuid()) @db.Uuid
  tripId        String         @db.Uuid
  dayId         String?        @db.Uuid
  createdById   String         @db.Uuid
  title         String
  description   String?
  location      String?
  startTime     String? // "HH:mm" local to the trip
  costPerPerson Decimal?       @db.Decimal(12, 2)
  status        ActivityStatus @default(PROPOSED)
  position      Int            @default(0)
  createdAt     DateTime       @default(now())

  trip      Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day       Day?   @relation(fields: [dayId], references: [id], onDelete: SetNull)
  createdBy User   @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  votes     Vote[]

  @@index([tripId, status])
  @@index([dayId, position])
}

model Vote {
  activityId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // one vote per user per proposal
  @@id([activityId, userId])
}

model Expense {
  id          String      @id @default(uuid()) @db.Uuid
  tripId      String      @db.Uuid
  paidById    String      @db.Uuid
  description String
  category    String      @default("Other")
  amount      Decimal     @db.Decimal(12, 2)
  splitMethod SplitMethod @default(EQUAL)
  spentAt     DateTime    @default(now())
  createdAt   DateTime    @default(now())

  trip   Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy User           @relation("ExpensePaidBy", fields: [paidById], references: [id])
  splits ExpenseSplit[]

  @@index([tripId, spentAt])
}

model ExpenseSplit {
  expenseId String  @db.Uuid
  userId    String  @db.Uuid
  amount    Decimal @db.Decimal(12, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([expenseId, userId])
}

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  tripId           String        @db.Uuid
  createdById      String        @db.Uuid
  type             BookingType
  status           BookingStatus @default(CONFIRMED)
  source           BookingSource @default(MANUAL)
  title            String
  provider         String?
  confirmationCode String?
  bookingUrl       String?
  /// Instants (UTC). `timeZone` is an IANA name or a fixed offset like "+01:00".
  startsAt         DateTime?
  endsAt           DateTime?
  timeZone         String?
  location         String?
  address          String?
  price            Decimal?      @db.Decimal(12, 2)
  currency         String?       @db.Char(3)
  travellers       Int?
  notes            String?
  /// Type-specific extras (seats, room type, …).
  details          Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  trip        Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy   User             @relation(fields: [createdById], references: [id])
  segments    BookingSegment[]
  attachments Attachment[]

  @@index([tripId, startsAt])
}

/// One leg of a flight or train booking.
model BookingSegment {
  id        String    @id @default(uuid()) @db.Uuid
  bookingId String    @db.Uuid
  position  Int
  carrier   String?
  number    String?
  fromCode  String?
  fromName  String?
  toCode    String?
  toName    String?
  departsAt DateTime
  arrivesAt DateTime?
  departTz  String?
  arriveTz  String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, position])
}

model Attachment {
  id            String   @id @default(uuid()) @db.Uuid
  tripId        String   @db.Uuid
  bookingId     String?  @db.Uuid
  uploadedById  String   @db.Uuid
  fileName      String
  mimeType      String
  sizeBytes     Int
  storageKey    String   @unique
  /// Plain text read from the file at upload (emails and PDFs), searched by the trip assistant.
  extractedText String?
  createdAt     DateTime @default(now())

  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@index([tripId, createdAt])
  @@index([bookingId])
}

/// Per-person reminder settings for a trip.
model ReminderPreference {
  tripId          String  @db.Uuid
  userId          String  @db.Uuid
  checkIn         Boolean @default(true)
  leaveForAirport Boolean @default(true)
  checkOut        Boolean @default(true)
  startingSoon    Boolean @default(false)
  email           Boolean @default(false)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
}

/// Dedupe log for emailed reminders.
model ReminderLog {
  userId String   @db.Uuid
  key    String
  sentAt DateTime @default(now())

  @@id([userId, key])
}

/// Personal access token for AI assistants (MCP). Only a SHA-256 hash of the token is stored.
model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  name       String
  /// SHA-256 (hex) of the full token; the token itself is shown to the user once and never stored.
  tokenHash  String    @unique
  /// First characters of the token ("tw_pat_ab12"), so people can tell their tokens apart.
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Searchable pieces of a trip (bookings, plans, documents) for the trip assistant (RAG).
/// `embedding` is a Voyage vector (pgvector); full-text search uses an expression index
/// created in the migration. Rows are kept in sync lazily by content hash.
model TripChunk {
  id        String                       @id @default(uuid()) @db.Uuid
  tripId    String                       @db.Uuid
  /// Stable per trip, e.g. "booking:<id>" or "doc:<attachmentId>#2".
  key       String
  kind      String
  /// The booking / activity / attachment the chunk came from, for citations.
  sourceId  String?
  title     String
  content   String
  /// SHA-256 of title + content + embedding model: unchanged chunks are never re-embedded.
  hash      String
  embedding Unsupported("vector(1024)")?
  updatedAt DateTime                     @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, key])
}

/// Questions and tokens per user per day, for the assistant's daily caps.
model AssistantUsage {
  day          DateTime @db.Date
  userId       String   @db.Uuid
  questions    Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([day, userId])
}
