# Copy to apps/api/.env  (cp .env.example apps/api/.env)
DATABASE_URL="postgresql://tripwise:tripwise@localhost:5432/tripwise?schema=public"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
WEB_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV=development

# Public URL of the API (used in calendar feed links)
PUBLIC_API_URL="http://localhost:4000"

# Document storage — MinIO from docker-compose (any S3-compatible service works)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="tripwise"
S3_ACCESS_KEY_ID="tripwise"
S3_SECRET_ACCESS_KEY="tripwise-secret"

# Reminder emails — Mailpit from docker-compose (remove to disable emails)
SMTP_URL="smtp://localhost:1025"

# Optional: let Claude read booking emails, PDFs and ticket photos (structured extraction).
# Without a key, Tripwise uses its built-in readers (schema.org data, calendar attachments, text rules).
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-5-5"

# Trip assistant: uses ANTHROPIC_API_KEY. Voyage adds semantic search (pgvector); free tier at voyageai.com.
# VOYAGE_API_KEY="pa-..."
# ASSISTANT_DAILY_QUESTIONS=20
# ASSISTANT_SITE_DAILY_QUESTIONS=300
