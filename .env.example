# Copy to apps/api/.env  (cp .env.example apps/api/.env)
DATABASE_URL="postgresql://tripwise:tripwise@localhost:5432/tripwise?schema=public"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
WEB_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV=development

# Public URL of the API (used in calendar feed links)
PUBLIC_API_URL="http://localhost:4000"

# Document storage — MinIO from docker-compose (any S3-compatible service works)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="tripwise"
S3_ACCESS_KEY_ID="tripwise"
S3_SECRET_ACCESS_KEY="tripwise-secret"

# Reminder emails — Mailpit from docker-compose (remove to disable emails)
SMTP_URL="smtp://localhost:1025"
